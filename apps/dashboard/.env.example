# Local dev — copy to .env.local. For Docker, use the root .env.example instead.
DATABASE_URL=postgres://postgres:password@localhost:5432/glance
BETTER_AUTH_SECRET=change-me-at-least-32-chars-long
BETTER_AUTH_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001
WS_SERVER_URL=http://localhost:4000
WS_INTERNAL_SECRET=change-me-internal-secret
PATIENT_DEVICE_TOKEN=replace-with-a-real-uuid
# Browser-exposed: WebSocket server the dashboard connects to for live alerts
NEXT_PUBLIC_WS_SERVER_URL=http://localhost:4000
# Browser-exposed: patient app base, used to build device setup links
NEXT_PUBLIC_PATIENT_APP_URL=http://localhost:3000
# OpenAI — tone classification + reply-suggestion ranking
OPENAI_API_KEY=
# ElevenLabs — cloned-voice TTS + in-app voice cloning (optional; falls back to on-device speech)
ELEVENLABS_API_KEY=
# Optional premade voice when no clone exists yet (e.g. a default ElevenLabs voice id)
ELEVENLABS_DEFAULT_VOICE_ID=
