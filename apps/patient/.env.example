# Local dev — copy to .env.local. For Docker, use the root .env.example instead.
#
# Optional static token for single-device deployments. Patients registered via
# the dashboard get a per-patient token from the DB and pair through the setup
# link instead — leave this unset in multi-patient setups.
PATIENT_DEVICE_TOKEN=replace-with-a-real-uuid
WS_SERVER_URL=http://localhost:4000
# Browser-facing dashboard origin (client fetches + setup links).
DASHBOARD_URL=http://localhost:3001
# Server-side dashboard URL for middleware token validation (Docker: http://dashboard:3001).
DASHBOARD_INTERNAL_URL=http://localhost:3001
MESSAGE_DISPLAY_SECONDS=30
