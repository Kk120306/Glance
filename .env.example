# Copy to .env and adjust before: docker compose up --build
#
# Generate secrets:
#   openssl rand -hex 32          # BETTER_AUTH_SECRET, WS_INTERNAL_SECRET
#   uuidgen                       # PATIENT_DEVICE_TOKEN

# ── Required ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=glance
BETTER_AUTH_SECRET=replace-with-openssl-rand-hex-32
WS_INTERNAL_SECRET=replace-with-openssl-rand-hex-32
PATIENT_DEVICE_TOKEN=replace-with-uuidgen

# ── Public URLs (browser-facing) ─────────────────────────────────────────────
# Default: same machine via localhost.
# LAN demo on another device: use this machine's IP, e.g. http://192.168.1.10:3001
# Rebuild after changing: docker compose up --build
PUBLIC_DASHBOARD_URL=http://localhost:3001
PUBLIC_PATIENT_URL=http://localhost:3000
PUBLIC_WS_URL=http://localhost:4000

# ── Host port overrides (optional) ──────────────────────────────────────────
# DASHBOARD_PORT=3001
# PATIENT_PORT=3000
# WS_PORT=4000

# ── Optional AI / voice features ────────────────────────────────────────────
# Without these, core messaging still works; compose assist, reply ranking,
# and cloned-voice TTS are disabled or fall back to on-device speech.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=

# ── Patient display tuning ──────────────────────────────────────────────────
MESSAGE_DISPLAY_SECONDS=30
